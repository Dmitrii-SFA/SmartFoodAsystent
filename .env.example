# Ключ Google Gemini API для запросов к нейросети (env.GEMINI_API_KEY)
GEMINI_API_KEY=

# Мастер-ключ владельца приложения (env.MASTER_KEY) — проверяется в первую очередь, даёт полный безлимит без проверок и списаний
MASTER_KEY=

# Список разрешённых базовых ключей активации пакетов на 500 запросов (env.ALLOWED_KEYS) — строка через запятую
ALLOWED_KEYS=

# В Cloudflare Worker также используется KV-привязка:
# USERS_KV — серверное хранилище Cloudflare KV для динамического учёта остатка запросов (пакет 500) и привязки устройств (максимум 2 устройства на ключ)
