# Ключ Google Gemini API для работы искусственного интеллекта
GEMINI_API_KEY=

# Список разрешённых ключей активации пакетов (по 500 ИИ-запросов каждый, до 2 устройств на ключ).
# Указывайте ключи через запятую, например: KEY-500-A1,KEY-500-B2,KEY-500-C3
ALLOWED_KEYS=

# Специальный мастер-ключ владельца приложения (полный безлимит, отключает проверки баланса и устройств)
MASTER_KEY=
